# ========================================================
# 1. DATABASE CONFIGURATION
# The application automatically detects SQLite vs PostgreSQL
# based on the connection string prefix!
# ========================================================
# Option A: Local SQLite (Zero setup, works immediately out of the box)
DATABASE_URL="file:./dev.db"

# Option B: Cloud PostgreSQL (NeonDB, Supabase, Cloud SQL, etc.)
# DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ========================================================
# 2. INSTAGRAM SCRAPER MODE
# Options:
#  - "auto"  : Tries Apify first, falls back to local browser (Recommended)
#  - "local" : Free local headless browser scraper (Zero cloud cost, uses residential IP)
#  - "apify" : Cloud Apify Actor (Best for Docker / Cloud Run / Vercel cloud deployments)
# ========================================================
SCRAPER_MODE="auto"
APIFY_API_KEY="apify_api_xxxxxxxxxxxxxxxxxxxx"

# ========================================================
# 3. YOUTUBE DATA API V3
# Optional for IG-only; required if tracking YouTube channels
# ========================================================
YOUTUBE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ========================================================
# 4. ADMIN & SCHEDULER SECURITY
# ========================================================
ADMIN_PASSWORD="genc2026"
CRON_SECRET="genc-secret-cron-token"

# ========================================================
# 5. DISCORD BROADCASTS (OPTIONAL)
# Pushes leaderboard summaries and breakout alerts after each sync
# ========================================================
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
